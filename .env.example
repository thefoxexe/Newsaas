# Optional. Only needed when the npm "playwright" package version doesn't
# match the Chromium build already installed on the machine (avoids a
# `playwright install` download). Point it at the local chrome binary.
PLAYWRIGHT_CHROMIUM_EXECUTABLE=

# Optional. Defaults to "ffmpeg" resolved from PATH.
FFMPEG_PATH=

# Required for Phase 3 (ConceptGenerator).
ANTHROPIC_API_KEY=

# Required for the DB layer (Phase 4+). Get this from the Supabase
# dashboard: Settings > Database > Connection string. Use the "Transaction"
# pooler string for serverless deploys (Netlify Functions, etc.) — the
# Postgres client is already configured for that (prepare: false).
DATABASE_URL=

# Required. Auth runs on Supabase Auth (not our own tables). Get these from
# the Supabase dashboard: Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for account deletion only (app/api/account/route.ts uses
# supabase.auth.admin.deleteUser, which needs elevated privileges). Get this
# from Settings > API — keep it server-side only, never expose it to the
# browser.
SUPABASE_SERVICE_ROLE_KEY=

# Required for Phase 5 (Stripe). This account (BroNote.ch) is in live
# mode — use the live secret key only once you mean to take real payments.
STRIPE_SECRET_KEY=

# From the webhook endpoint's settings in the Stripe dashboard, once
# /api/webhooks/stripe is deployed somewhere Stripe can reach it.
STRIPE_WEBHOOK_SECRET=

# Required. The app's own URL, e.g. http://localhost:3000 locally or
# https://reeljolt.<something>.netlify.app in production.
NEXT_PUBLIC_APP_URL=

# Optional. Google/GitHub sign-in are configured entirely in the Supabase
# dashboard (Authentication > Providers) — enable each provider there with
# its own client id/secret, redirect URI:
# https://<project>.supabase.co/auth/v1/callback. No env vars needed here.

# Optional, worker only. Where rendered MP4s land — a placeholder until
# real object storage (Cloudflare R2) is wired up. Defaults to
# ./public/renders, served at /renders.
RENDER_STORAGE_DIR=
RENDER_PUBLIC_BASE_URL=
